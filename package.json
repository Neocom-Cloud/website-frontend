{
  "name": "neocom-website-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "generate:pages": "node scripts/generate-pages.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:build-output": "vitest run --config vitest.build.config.ts",
    "test:e2e": "playwright test",
    "test:visual": "cross-env VISUAL_SNAPSHOTS=1 playwright test visual-snapshots --project=chromium",
    "test:visual:update": "cross-env VISUAL_SNAPSHOTS=1 playwright test visual-snapshots --project=chromium --update-snapshots",
    "verify:promotion": "node scripts/verify-promotion.mjs",
    "verify:pages": "node scripts/verify-pages-status.mjs",
    "verify:repository": "node scripts/verify-repository-integrity.mjs"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
