locals {
  # Generated by scripts/generate-dns-json.mjs from scripts/dns-records.mjs,
  # which is also what `pnpm verify:dns` checks against. One source, so the
  # verifier cannot pass while this stack is missing a record.
  preserved = { for record in jsondecode(file("${path.module}/records.json")) : record.key => record }
}

# Mail and domain verification. These are the records that must survive the
# move untouched: losing MX bounces incoming mail visibly, while losing SPF or
# DKIM only degrades outgoing deliverability, which goes unnoticed for weeks.
#
# None of them is proxied. Cloudflare's proxy handles HTTP and HTTPS only, and
# an orange cloud on anything mail-related breaks it.
resource "cloudflare_dns_record" "preserved" {
  for_each = local.preserved

  zone_id  = var.cloudflare_zone_id
  name     = each.value.name
  type     = each.value.type
  content  = each.value.content
  priority = each.value.type == "MX" ? each.value.priority : null
  ttl      = var.mail_ttl
  proxied  = false
  comment  = each.value.comment
}

# Web records, declared separately because they follow whichever host serves
# the site and will change; the set above must not.
# They start grey: proxy_web defaults to false, which is Phase 1 of the
# runbook in docs/deployment.md. A proxied record in front of an origin
# that carries no certificate for this domain yet answers 526.
locals {
  github_pages_ips = [
    "185.199.108.153",
    "185.199.109.153",
    "185.199.110.153",
    "185.199.111.153"
  ]

  apex_a_records = var.web_target == "github-pages" ? toset(local.github_pages_ips) : toset([])
}

resource "cloudflare_dns_record" "apex_github_pages" {
  for_each = local.apex_a_records

  zone_id = var.cloudflare_zone_id
  name    = var.domain
  type    = "A"
  content = each.value
  ttl     = 1
  proxied = var.proxy_web
  comment = "GitHub Pages apex"
}

resource "cloudflare_dns_record" "www_github_pages" {
  count = var.web_target == "github-pages" ? 1 : 0

  zone_id = var.cloudflare_zone_id
  name    = "www.${var.domain}"
  type    = "CNAME"
  content = "neocom-cloud.github.io"
  ttl     = 1
  proxied = var.proxy_web
  comment = "GitHub Pages alternate host"
}

# CloudFront already presents a valid certificate, so the zone can run
# SSL/TLS in Full (strict) — unlike the S3 website endpoint, which is
# HTTP-only and would force Flexible.
# That distinction only bites once proxy_web is true; a grey record reaches
# the distribution directly, on its own certificate.
resource "cloudflare_dns_record" "apex_cloudfront" {
  count = var.web_target == "cloudfront" ? 1 : 0

  zone_id = var.cloudflare_zone_id
  name    = var.domain
  type    = "CNAME"
  content = var.cloudfront_domain
  ttl     = 1
  proxied = var.proxy_web
  comment = "CloudFront distribution (apex, flattened by Cloudflare)"

  lifecycle {
    precondition {
      condition     = var.cloudfront_domain != ""
      error_message = "cloudfront_domain is required when web_target is cloudfront."
    }
  }
}

resource "cloudflare_dns_record" "www_cloudfront" {
  count = var.web_target == "cloudfront" ? 1 : 0

  zone_id = var.cloudflare_zone_id
  name    = "www.${var.domain}"
  type    = "CNAME"
  content = var.cloudfront_domain
  ttl     = 1
  proxied = var.proxy_web
  comment = "CloudFront distribution (www)"
}

# Monitoring only: p=none cannot reject mail, and the reports show what is
# sending as the domain. Do not raise the policy without reading them first.
resource "cloudflare_dns_record" "dmarc" {
  count = var.create_dmarc ? 1 : 0

  zone_id = var.cloudflare_zone_id
  name    = "_dmarc.${var.domain}"
  type    = "TXT"
  content = "v=DMARC1; p=none; rua=mailto:${var.dmarc_report_address}"
  ttl     = var.mail_ttl
  proxied = false
  comment = "DMARC in monitoring mode"
}
